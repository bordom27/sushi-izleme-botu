var bool   yakU = false
var bool   yakL = false

// dönüş formasyonu: aday (a…) ve aktif (d…). Noktalar: ikili 3, OBO 5 (tepe/dip sırayla).
var bool   aVar = false
var string aTur = ""
var bool   aTers = false
var float  aYuk = na
var int    aGen = na
var float  aGec = na
