     29.0, 22.0, 34.0, 37.0, 41.0, 27.0, 22.0, 31.0, 24.0, 19.0, 35.0, 0.0, 35.0, 47.0, 48.0, 35.0, 0.0, 34.0, 36.0, 39.0,
