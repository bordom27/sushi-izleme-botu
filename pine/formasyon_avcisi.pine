var string dTur = ""
var bool   dTers = false
var float  dYuk = na
var int    dGen = na
var float  dGec = na
var int    dBi0 = na
var float  dBp0 = na
var float  dBs = 0.0
var string dKey = ""
var bool   dYakin = false
var array<int>   dPX = array.new<int>()
var array<float> dPP = array.new<float>()
var array<bool>  dPT = array.new<bool>()

ustDeger(int x) => uP0 + uS * (x - uI0)
altDeger(int x) => lP0 + lS * (x - lI0)
dBoyun(int x) => dBp0 + dBs * (x - dBi0)
aBoyun(int x) => aBp0 + aBs * (x - aBi0)
oncelik(string t) => t == "obo" or t == "ters_obo" ? 3 : t == "ucgen" ? 2 : 1
desenAd(string t) => t == "ikili_tepe" ? "İkili tepe" : t == "ikili_dip" ? "İkili dip" : t == "obo" ? "Omuz-baş-omuz" : "Ters omuz-baş-omuz"

// ───────── geçmiş isabet: güven derecesi ─────────
// ucgen_istatistik.py sonuçları (2026-11-01): her kırılım sonrası en fazla 100 mumda, geçersizliğe dokunmadan
// hedefe ulaşma oranı (stH, %), işlem başına ortalama sonuç (stR, R: giriş kırılım kapanışı, stop geçersizlik,
// kâr al hedef) ve geçmiş kırılım sayısı (stN). Dizin = (formasyon × 4 + piyasa) × 5 + zaman dilimi.
