//@version=6
// ══════════════════════════════════════════════════════════════════════
//  FORMASYON AVCISI  (daralan üçgen + ikili tepe/dip + omuz-baş-omuz)
//  Telegram tarayıcısı (ucgen_tarayici.py) ile birebir aynı kurallar.
// ──────────────────────────────────────────────────────────────────────
//  DARALAN ÜÇGEN
//   Çizgi mumun görünen ucuna dayanır (fitil gövdeden 1 ATR'den uzunsa gövdeye). Her tepe/dip
//   başlangıcından sonrakilere en sıkı yaslanan çizgi; bütün çiftler denenir. Her büyük salınım
//   karşı çizgiye değer, her çizgide en az 2 ayrı dokunuş, iki çizgi aynı mumdan çıkmaz.
//  İKİLİ TEPE / DİP
//   İki tepe (dip) eşit seviyede: fark ≤ min(yüksekliğin %15'i, 1 ATR); yükseklik ≥ 3 ATR;
//   aralarında 10–100 mum, temiz M / W (bacaklarda ters salınım yok), formasyona güçlü
//   hareketle girilmiş, hiçbir bacak tek mumla oluşmamış. Boyun = aradaki dip (tepe).
//  OMUZ-BAŞ-OMUZ (normal / ters)
//   Baş, omuzlardan belirgin yüksek; omuzlar benzer seviyede ve boyundan yeterince yüksek;
//   boyun çizgisi fazla eğimli değil; zaman simetrisi; temiz bacaklar.
//  Formasyonlar aynı noktayı paylaşmaz (aynı yerden iki çizgi çıkmaz). Öncelik: OBO > üçgen > ikili.
//  BÜYÜK ÜÇGEN: önce elle çizen gibi büyük üçgen aranır: çizgi mumların kenarından geçer (hiçbir fitil ucu
//   çizgiyi delmez, ani çöküş iğnesi hariç), ara dalgalar çizgiye değmek zorunda değil, kırılımdan hemen önceki
//   son dokunuş onay beklemeden sayılır, üçgen güçlü bir hareketin ardından başlar; 300 mumluk pencere, son 1000
//   mum. Bulunursa içindeki küçük üçgenler gösterilmez. Kırılım, çizgiler yeniden çizilmeden önce denetlenir.
//  Hesaplar log fiyatla yapılır (log grafikte çizgiler düz, hedefler yüzdesel).
//  Sinyaller: kırılıma / boyuna yakın (0,75 ATR) ve kırılım / onay (0,3 ATR dışında kapanış).
//  Hedef = ölçülen hareket (formasyon yüksekliği).
// ══════════════════════════════════════════════════════════════════════
indicator("Formasyon Avcısı", overlay = true, max_lines_count = 200, max_labels_count = 250, max_bars_back = 500)

grpA = "Daralan üçgen"
pvN    = input.int(5, "Pivot gücü (sol/sağ mum)", minval = 2, maxval = 20, group = grpA)
maxBar = input.int(150, "En uzun üçgen (mum)", minval = 30, maxval = 400, group = grpA)
minBar = input.int(20, "En kısa üçgen (mum)", minval = 5, group = grpA)
tolAtr = input.float(0.3, "Kapanış toleransı (× ATR)", minval = 0, step = 0.05, group = grpA)
yatay  = input.float(0.10, "Yatay sayılma eşiği (yüksekliğe oranla)", minval = 0, step = 0.05, group = grpA)
minYuk = input.float(3.0, "En az yükseklik (× ATR)", minval = 0, step = 0.5, group = grpA)
darMax = input.float(0.85, "Daralma şartı (bugünkü genişlik / başlangıç)", minval = 0.1, maxval = 1, step = 0.05, group = grpA)
grpC = "Çizgi kalitesi"
fitilAtr = input.float(1.0, "Fitil sınırı (× ATR, daha uzun fitilde gövde)", minval = 0, step = 0.25, group = grpC)
salTeta  = input.float(0.40, "Büyük salınım (genişliğin oranı)", minval = 0.1, maxval = 0.9, step = 0.05, group = grpC)
dokAtr   = input.float(0.75, "Dokunuş: en fazla (× ATR)", minval = 0, step = 0.05, group = grpC)
dokGen   = input.float(0.20, "Dokunuş: en fazla (genişliğin oranı)", minval = 0, step = 0.05, group = grpC)
kabAtr   = input.float(1.5, "Çizgiden kopma sınırı (× ATR)", minval = 0, step = 0.25, group = grpC)
kabGen   = input.float(0.30, "Çizgiden kopma sınırı (genişliğin oranı)", minval = 0, step = 0.05, group = grpC)
minDok   = input.int(2, "Her çizgide en az dokunuş", minval = 2, maxval = 5, group = grpC)
grpE = "Büyük formasyon"
buyukOn = input.bool(true, "Önce büyük üçgeni ara (elle çizen gibi)", group = grpE)
logOn   = input.bool(true, "Log fiyatla hesapla (log grafikte çizgiler düz)", group = grpE)
grpD = "Dönüş formasyonları"
showIk  = input.bool(true, "İkili tepe / ikili dip", group = grpD)
showObo = input.bool(true, "Omuz-baş-omuz (normal / ters)", group = grpD)
grpB = "Sinyal ve görünüm"
yakAtr  = input.float(0.75, "Kırılıma / boyuna yakın mesafesi (× ATR)", minval = 0, step = 0.25, group = grpB)
gecmis  = input.bool(true, "Geçmiş formasyonları ve kırılımları da çiz", group = grpB)
showDok = input.bool(true, "Üçgen dokunuş noktalarını işaretle", group = grpB)
showHes = input.bool(true, "Üçgen içinde hesapları göster (H, kırılım eşikleri, hedefler, risk/ödül)", group = grpB)
showT   = input.bool(true, "Bilgi panelini göster", group = grpB)
cUst    = input.color(color.orange, "Üçgen üst çizgi", group = grpB)
cAlt    = input.color(color.blue, "Üçgen alt çizgi", group = grpB)
cBoyun  = input.color(#ffd54f, "Boyun çizgisi", group = grpB)

// tarayıcıyla aynı sabitler
MAXP     = 12      // üçgen: pencere içindeki en son 12 tepe / dip
DENGE    = 0.50    // üçgen: iki çizginin başlangıç farkı ≤ sürenin yarısı
TASMA    = 0.25    // üçgen: sonra başlayan çizgi geriye uzatılınca gerçek fiyatın dışına taşma sınırı
MAXBACAK = 0.50    // üçgen: tek bir bacak ≤ sürenin yarısı
MAXOMUR  = 450     // bu kadar mumdan eski formasyon / aday bırakılır (geçmiş sınırı)
TEKMUM   = 0.5     // bir bacağı tek mum yapamaz: gövde > max(bacağın yarısı, 2 × ortalama mum boyu)
TEKORT   = 2.0
D_MINYUK = 3.0     // dönüş: yükseklik ≥ 3 ATR
D_ESIT   = 0.15    // ikili: iki tepe farkı ≤ min(yüksekliğin %15'i, 1 ATR)
D_ESITA  = 1.0
D_MINARA = 10      // ikili: iki tepe arası mum
D_MAXARA = 100
D_DENGE  = 0.25    // ikili: kısa bacak / uzun bacak (süre)
D_ONCEKI = 1.0     // ikili: girişte hareket ≥ 1 × yükseklik
D_ONCOBO = 0.6     // OBO: sol omza girişte hareket ≥ 0,6 × baş yüksekliği
D_TEMIZ  = 0.40    // bacaklarda yüksekliğe göre %40'lık ters salınım yok
D_DOLU   = 0.20    // aradaki kapanışların ≥ %20'si formasyonun iç yarısında
D_FITIL  = 1.0     // gerçek fitil seviyeyi en fazla 1 ATR aşabilir
D_BASFRK = 0.20    // OBO: baş, yüksek omuzdan ≥ %20 yükseklik fazla
D_OMUZMN = 0.40    // OBO: her omuz boyundan ≥ %40 yükseklikte
D_OMUZSV = 0.30    // OBO: omuzlar arası fark ≤ %30 yükseklik
D_BOYEGM = 0.25    // OBO: iki boyun noktası farkı ≤ %25 yükseklik
D_ZAMAN  = 0.40    // OBO: kısa yan / uzun yan (süre)
D_MINGEN = 15      // OBO: sol omuzdan sağ omuza mum
D_MAXGEN = 150
D_ONAY   = 0.20    // son noktadan max(1 ATR, %20 yükseklik) uzaklaşınca formasyon gösterilir
D_ONAYA  = 1.0
D_OMUR   = 0.75    // son noktadan sonra genişliğin %75'i (en az 15 mum) içinde kırılmazsa biter
D_YAKIN  = 2       // iki nokta "aynı yer": aynı tip ve ≤ 2 mum
DIZI     = 240     // dönüş aramasının okuduğu geçmiş (mum)
// büyük üçgen (tarayıcıyla aynı): uzun pencere, fitil uçları, ara dalgalar çizgiye değmek zorunda değil
B_MAXBAR = 300
B_MINBAR = 50
B_MAXP   = 24
B_FITILG = 1.5     // fitil ucu: fitil ≤ max(1 ATR, gövdenin 1,5 katı); daha uzun iğnede gövde
B_KABGEN = 0.50    // çizgiye değmeyen ara dalga en az ortaya kadar gelmeli (genişliğin yarısı)
B_DENGE  = 0.50    // destek / direnç sonradan oluşabilir (alçalan üçgende yatay dip) ...
B_DAPEX  = 0.25    // ... ama üçgen %25'ten fazla daralmadan (başlangıç → apex yolu) başlamalı
B_ONCEKI = 1.0     // üçgene giriş hareketi ≥ 1 × taban: büyük hareketin içini değil, ardındaki sıkışmayı çiz
B_PUANW  = 10.0    // seçim puanı: taban (log) × 10 + dokunuş: önce en büyük yapı
SAG      = 2       // geçici pivot: son pvN mum içinde, en az 2 mum önce (son dokunuş onay beklemez)
B_KIRH   = 0.05    // kırılım: kapanış çizginin max(0,3 ATR, tabanın %5'i) dışında
B_GECMIS = 1000    // büyük üçgen son 1000 mumda aranır (hesap süresi)

// tespit uzayı: log fiyat (log grafikte çizgiler düz, ölçüler yüzdesel). Ekrana yazarken fx() ile fiyata çevrilir.
float pH = logOn ? math.log(high) : high
float pL = logOn ? math.log(low) : low
float pO = logOn ? math.log(open) : open
float pC = logOn ? math.log(close) : close
float trP = na(pC[1]) ? pH - pL : math.max(pH - pL, math.abs(pH - pC[1]), math.abs(pL - pC[1]))
atr14 = ta.rma(trP, 14)
fx(float v) => logOn ? math.exp(v) : v
phv = ta.pivothigh(high, pvN, pvN)
plv = ta.pivotlow(low, pvN, pvN)

// mumun çizgi için ucu (Python: uclar): fitil gövdeden fitilAtr × ATR'den kısaysa fitilin ucu, değilse gövde
float govU = math.max(pO, pC)
float govA = math.min(pO, pC)
float ucT = pH - govU <= fitilAtr * atr14 ? pH : govU
float ucD = govA - pL <= fitilAtr * atr14 ? pL : govA
// büyük üçgen: güçlü mumun uzun fitili de uç sayılır (ani çöküş iğnesi sayılmaz)
float sinB = math.max(fitilAtr * atr14, B_FITILG * (govU - govA))
float ucTB = pH - govU <= sinB ? pH : govU
float ucDB = govA - pL <= sinB ? pL : govA

var array<int>    phB = array.new<int>()
var array<float>  phP = array.new<float>()
var array<int>    plB = array.new<int>()
var array<float>  plP = array.new<float>()
var array<float>  phPB = array.new<float>()   // büyük üçgen için uç (fitil kuralı farklı)
var array<float>  plPB = array.new<float>()
var array<string> bozuk = array.new<string>()
// kullanılmış noktalar: biten formasyonların çizgi başlangıçları (aynı yerden iki çizgi çıkmasın)
var array<int>  kulX = array.new<int>()
var array<bool> kulT = array.new<bool>()     // true = tepe, false = dip

// aday üçgen çizgileri
var array<int>   cuI = array.new<int>()
var array<float> cuP = array.new<float>()
var array<float> cuS = array.new<float>()
var array<int>   cuF = array.new<int>()
var array<int>   clI = array.new<int>()
var array<float> clP = array.new<float>()
var array<float> clS = array.new<float>()
var array<int>   clF = array.new<int>()
var array<float> sufH = array.new<float>()
var array<float> sufL = array.new<float>()
// geçmiş (indeks = kaç mum önce), her kurulumda doldurulur
var array<float> aT = array.new<float>()
var array<float> aD = array.new<float>()
var array<float> aTB = array.new<float>()
var array<float> aDB = array.new<float>()
var array<float> aA = array.new<float>()
var array<float> aH = array.new<float>()
var array<float> aL = array.new<float>()
var array<float> aO = array.new<float>()
var array<float> aC = array.new<float>()
// üçgen dokunuş noktaları: aktif (dk) ve aday (ck)
var array<int>  dkX = array.new<int>()
var array<bool> dkU = array.new<bool>()
var array<int>  ckX = array.new<int>()
var array<bool> ckU = array.new<bool>()

// ───────── ortak yardımcılar ─────────
tekMum(int b, int xa, int xb, float genlik) =>
    bool r = false
    if xb > xa
        float gmax = 0.0
        float top = 0.0
        for x = xa + 1 to xb
            int o = b - x
            gmax := math.max(gmax, math.abs(array.get(aC, o) - array.get(aO, o)))
            top += array.get(aH, o) - array.get(aL, o)
        r := gmax > math.max(TEKMUM * math.abs(genlik), TEKORT * top / (xb - xa))
    r

// iki nokta listesi aynı yeri paylaşıyor mu (aynı tip, ≤ D_YAKIN mum)
cakisir(array<int> ax_, array<bool> at_, array<int> bx_, array<bool> bt_) =>
    bool r = false
    int na_ = array.size(ax_)
    int nb_ = array.size(bx_)
    if na_ > 0 and nb_ > 0
        for i = 0 to na_ - 1
            for j = 0 to nb_ - 1
                if array.get(at_, i) == array.get(bt_, j) and math.abs(array.get(ax_, i) - array.get(bx_, j)) <= D_YAKIN
                    r := true
                    break
            if r
                break
    r

// ───────── üçgen: aday çizgiler (Python: cizgiler) ─────────
// B (büyük üçgen): hiçbir mumun ucu çizgiyi tol'den fazla aşamaz (çizgi mumların kenarından geçer)
cizgiAdaylari(array<int> bs, array<float> ps, int b, float tol, bool ust, array<int> oI, array<float> oP, array<float> oS, array<int> oF, int mBar, int mP, bool B) =>
    array<float> uc = ust ? aTB : aDB
    array.clear(oI)
    array.clear(oP)
    array.clear(oS)
    array.clear(oF)
    int n = array.size(bs)
    int j0 = n
    if n > 0
        for j = n - 1 to 0
            int bj = array.get(bs, j)
            if bj >= b - mBar
                if bj <= b - (B ? SAG : pvN)
                    j0 := j
            else
                break
    j0 := math.max(j0, n - mP)
    float sg = ust ? 1.0 : -1.0
    if n - j0 >= 2
        for a = j0 to n - 2
            int i0 = array.get(bs, a)
            float p0 = array.get(ps, a)
            float smin = na
            for e = a + 1 to n - 1
                float sn = ((array.get(ps, e) - sg * tol) - p0) / (array.get(bs, e) - i0)
                smin := na(smin) ? sn : ust ? math.max(smin, sn) : math.min(smin, sn)
            float sonS = na
            bool bulundu = false
            int deneme = 0
            while not bulundu and deneme < n - 1 - a
                float enS = na
                for e = a + 1 to n - 1
                    float s = (array.get(ps, e) - p0) / (array.get(bs, e) - i0)
                    bool gec = ust ? s >= smin - 1e-12 : s <= smin + 1e-12
                    bool yeni = na(sonS) or (ust ? s > sonS : s < sonS)
                    if gec and yeni and (na(enS) or (ust ? s < enS : s > enS))
                        enS := s
                if na(enS)
                    break
                sonS := enS
                deneme += 1
                bool ok = true
                for x = i0 to b
                    float cz = p0 + enS * (x - i0)
                    if sg * (array.get(aC, b - x) - cz) > tol or (B and sg * (array.get(uc, b - x) - cz) > tol)
                        ok := false
                        break
                if ok
                    int x = i0 - 1
                    while x >= b - mBar and b - x < array.size(aC) and sg * (array.get(aC, b - x) - (p0 + enS * (x - i0))) <= tol and (not B or sg * (array.get(uc, b - x) - (p0 + enS * (x - i0))) <= tol)
                        x -= 1
                    int ser = x + 1
                    if a > j0
                        for e = j0 to a - 1
                            int be = array.get(bs, e)
                            if be >= ser and be < i0 and sg * (array.get(ps, e) - (p0 + enS * (be - i0))) > tol
                                ser := math.max(ser, be + 1)
                    array.push(oI, i0)
                    array.push(oP, p0)
                    array.push(oS, enS)
                    array.push(oF, ser)
                    bulundu := true
    j0

// ───────── üçgen: salınım denetimi (Python: salinim) ─────────
// Döndürür: [ihlal, üst dokunuş, alt dokunuş, yakın geçen]; kaydet ise dokunuş noktaları ox/ou'ya yazılır
salinim(int x0, int b, int ui0, float up0, float us, int li0, float lp0, float ls, bool ustBas, bool kaydet, array<int> ox, array<bool> ou, bool B) =>
    array<float> tT = B ? aTB : aT
    array<float> tD = B ? aDB : aD
    int nn = b - x0
    int ihlal = 0
    int ud = 0
    int ad = 0
    int yakin = 0
    if kaydet
        array.clear(ox)
        array.clear(ou)
        array.push(ox, x0)
        array.push(ou, ustBas)
    float U0 = up0 + us * (x0 - ui0)
    float L0 = lp0 + ls * (x0 - li0)
    float W0 = U0 - L0
    if W0 <= 0
        ihlal := 99
    bool ararDip = ustBas
    float aday = na
    int ax = 0
    int sonDonus = 0
    int enBacak = 0
    float pOnc = ustBas ? array.get(tT, b - x0) : array.get(tD, b - x0)
    if ihlal == 0
        if ustBas
            ud := 1
            aday := (array.get(tD, b - x0) - L0) / W0
        else
            ad := 1
            aday := (array.get(tT, b - x0) - L0) / W0
        for r = 1 to nn
            int x = x0 + r
            float Lx = lp0 + ls * (x - li0)
            float Wx = up0 + us * (x - ui0) - Lx
            if Wx <= 0
                ihlal := 99
                break
            float hp = (array.get(tT, b - x) - Lx) / Wx
            float lp = (array.get(tD, b - x) - Lx) / Wx
            if ararDip
                if lp < aday
                    aday := lp
                    ax := r
                else if hp >= aday + salTeta
                    int xa = x0 + ax
                    float Wa = up0 + us * (xa - ui0) - (lp0 + ls * (xa - li0))
                    float aa = array.get(aA, b - xa)
                    float td = math.min(dokAtr * aa, dokGen * Wa) / Wa
                    float tk = (B ? B_KABGEN * Wa : math.min(kabAtr * aa, kabGen * Wa)) / Wa
                    if ax != sonDonus                  // önceki tepeyle aynı mum (tek mum tüm genişlik) dokunuş değil
                        if aday <= td
                            ad += 1
                            if kaydet
                                array.push(ox, xa)
                                array.push(ou, false)
                        else if aday > tk
                            ihlal += 1
                        else
                            yakin += 1
                    float pYeni = array.get(tD, b - xa)
                    if not B and tekMum(b, x0 + sonDonus, xa, pYeni - pOnc)
                        ihlal += 1
                    enBacak := math.max(enBacak, ax - sonDonus)
                    sonDonus := ax
                    pOnc := pYeni
                    ararDip := false
                    aday := hp
                    ax := r
            else
                if hp > aday
                    aday := hp
                    ax := r
                else if lp <= aday - salTeta
                    int xa = x0 + ax
                    float Wa = up0 + us * (xa - ui0) - (lp0 + ls * (xa - li0))
                    float aa = array.get(aA, b - xa)
                    float td = math.min(dokAtr * aa, dokGen * Wa) / Wa
                    float tk = (B ? B_KABGEN * Wa : math.min(kabAtr * aa, kabGen * Wa)) / Wa
                    if ax != sonDonus
                        if 1 - aday <= td
                            ud += 1
                            if kaydet
                                array.push(ox, xa)
                                array.push(ou, true)
                        else if 1 - aday > tk
                            ihlal += 1
                        else
                            yakin += 1
                    float pYeni = array.get(tT, b - xa)
                    if not B and tekMum(b, x0 + sonDonus, xa, pYeni - pOnc)
                        ihlal += 1
                    enBacak := math.max(enBacak, ax - sonDonus)
                    sonDonus := ax
                    pOnc := pYeni
                    ararDip := true
                    aday := lp
                    ax := r
        if ihlal < 99
            enBacak := math.max(enBacak, nn - sonDonus)
            if enBacak > MAXBACAK * nn
                ihlal += 1
            // büyük üçgen: son dip / tepe çizgiye değdiyse (dönüşü henüz büyük değil) dokunuş sayılır
            if B and ax != sonDonus and ax <= nn - SAG
                int xa = x0 + ax
                float Wa = up0 + us * (xa - ui0) - (lp0 + ls * (xa - li0))
                float td = math.min(dokAtr * array.get(aA, b - xa), dokGen * Wa) / Wa
                if ararDip and aday <= td
                    ad += 1
                    if kaydet
                        array.push(ox, xa)
                        array.push(ou, false)
                else if not ararDip and 1 - aday <= td
                    ud += 1
                    if kaydet
                        array.push(ox, xa)
                        array.push(ou, true)
    [ihlal, ud, ad, yakin]

// ───────── dönüş formasyonları (Python: ikili / obo) ─────────
// Hesaplar "tepe" yönünde yapılır; dip formasyonlarında fiyatlar ters çevrilir (−fiyat).
fU(int b, int x, bool ters) => ters ? -array.get(aD, b - x) : array.get(aT, b - x)
fA(int b, int x, bool ters) => ters ? -array.get(aT, b - x) : array.get(aD, b - x)
fG(int b, int x, bool ters) => ters ? -array.get(aL, b - x) : array.get(aH, b - x)
fK(int b, int x, bool ters) => ters ? -array.get(aC, b - x) : array.get(aC, b - x)

bacakTemiz(int b, int xa, int xb, bool asagi, float teta, bool ters) =>
    bool ok = true
    if xb - xa >= 2
        float m = asagi ? 1e100 : -1e100
        for x = xa + 1 to xb - 1
            if asagi
                if fU(b, x, ters) > m + teta
                    ok := false
                    break
                m := math.min(m, fA(b, x, ters))
            else
                if fA(b, x, ters) < m - teta
                    ok := false
                    break
                m := math.max(m, fU(b, x, ters))
    ok

onceOk(int b, int x1, float v1, float yuk, int K, float Ab, float oran, bool ters) =>
    int a = math.max(math.max(0, x1 - K), b - (array.size(aT) - 1))
    bool ok = x1 - a >= 5
    if ok
        float mx = -1e100
        for x = a to x1 - 1
            mx := math.max(mx, fU(b, x, ters))
        ok := mx <= v1 + 0.25 * Ab
    if ok
        float mn = 1e100
        for x = a to x1
            mn := math.min(mn, fA(b, x, ters))
        ok := v1 - mn >= oran * yuk
    ok

// ikili tepe (ters: ikili dip). Son pivot ikinci tepe mi. Döndürür: [bulundu, x1, xt, x2, yükseklik]
ikiliBul(int b, array<int> piv, bool ters, float Ab) =>
    int n = array.size(piv)
    bool bul = false
    int rx1 = na
    int rxt = na
    int rx2 = na
    float ryuk = na
    if n >= 2
        int x2 = array.get(piv, n - 1)
        float v2 = fU(b, x2, ters)
        for j = n - 2 to 0
            int x1 = array.get(piv, j)
            int ara = x2 - x1
            if ara > D_MAXARA
                break
            if ara < D_MINARA
                continue
            float v1 = fU(b, x1, ters)
            int xt = x1
            float vt = fA(b, x1, ters)
            for x = x1 + 1 to x2
                float ax_ = fA(b, x, ters)
                if ax_ < vt
                    vt := ax_
                    xt := x
            float tepe = math.max(v1, v2)
            float yuk = tepe - vt
            if yuk < D_MINYUK * Ab or math.abs(v1 - v2) > math.min(D_ESIT * yuk, D_ESITA * Ab)
                continue
            float mx = -1e100
            for x = x1 + 1 to x2 - 1
                mx := math.max(mx, fU(b, x, ters))
            if mx > tepe + 0.25 * Ab
                continue
            float gmx = -1e100
            for x = x1 to x2
                gmx := math.max(gmx, fG(b, x, ters))
            if gmx > tepe + D_FITIL * Ab
                continue
            if math.min(xt - x1, x2 - xt) < D_DENGE * math.max(xt - x1, x2 - xt)
                continue
            int icte = 0
            for x = x1 + 1 to x2 - 1
                if fK(b, x, ters) <= tepe - 0.5 * yuk
                    icte += 1
            if icte < D_DOLU * (x2 - x1 - 1)
                continue
            float teta = D_TEMIZ * yuk
            if not (bacakTemiz(b, x1, xt, true, teta, ters) and bacakTemiz(b, xt, x2, false, teta, ters))
                continue
            if tekMum(b, x1, xt, v1 - vt) or tekMum(b, xt, x2, v2 - vt)
                continue
            if not onceOk(b, x1, v1, yuk, math.max(ara, 20), Ab, D_ONCEKI, ters)
                continue
            bul := true
            rx1 := x1
            rxt := xt
            rx2 := x2
            ryuk := yuk
            break
    [bul, rx1, rxt, rx2, ryuk]

// omuz-baş-omuz (ters: ters OBO). Son pivot sağ omuz mu. Döndürür: [bulundu, xl, x1, xh, x2, xr, yükseklik]
oboBul(int b, array<int> piv, bool ters, float Ab) =>
    int n = array.size(piv)
    bool bul = false
    int rxl = na
    int rx1 = na
    int rxh = na
    int rx2 = na
    int rxr = na
    float ryuk = na
    if n >= 3
        int xr = array.get(piv, n - 1)
        float vr = fU(b, xr, ters)
        for ih = n - 2 to 1
            int xh = array.get(piv, ih)
            if xr - xh > D_MAXGEN
                break
            float vh = fU(b, xh, ters)
            if vh <= vr
                continue
            for il = ih - 1 to 0
                int xl = array.get(piv, il)
                int gen = xr - xl
                if gen > D_MAXGEN
                    break
                if gen < D_MINGEN
                    continue
                float vl = fU(b, xl, ters)
                if vl >= vh
                    break
                int x1 = xl
                float v1 = fA(b, xl, ters)
                for x = xl + 1 to xh
                    float t_ = fA(b, x, ters)
                    if t_ < v1
                        v1 := t_
                        x1 := x
                int x2 = xh
                float v2 = fA(b, xh, ters)
                for x = xh + 1 to xr
                    float t_ = fA(b, x, ters)
                    if t_ < v2
                        v2 := t_
                        x2 := x
                if not (xl < x1 and x1 < xh and xh < x2 and x2 < xr)
                    continue
                float s = (v2 - v1) / (x2 - x1)
                float yuk = vh - (v1 + s * (xh - x1))
                if yuk < D_MINYUK * Ab
                    continue
                float hL = vl - (v1 + s * (xl - x1))
                float hR = vr - (v1 + s * (xr - x1))
                if vh - math.max(vl, vr) < math.max(D_BASFRK * yuk, 0.5 * Ab)
                    continue
                if math.min(hL, hR) < D_OMUZMN * yuk or math.abs(vl - vr) > D_OMUZSV * yuk
                    continue
                if math.abs(v2 - v1) > D_BOYEGM * yuk
                    continue
                int dl = xh - xl
                int dr = xr - xh
                if math.min(dl, dr) / math.max(dl, dr) < D_ZAMAN
                    continue
                int icte = 0
                if x2 - x1 >= 2
                    for x = x1 + 1 to x2 - 1
                        if fK(b, x, ters) - (v1 + s * (x - x1)) >= 0.5 * yuk
                            icte += 1
                if icte < D_DOLU * (x2 - x1 - 1)
                    continue
                float mx = -1e100
                for x = xl + 1 to xr - 1
                    mx := math.max(mx, fU(b, x, ters))
                float gmx = -1e100
                for x = xl to xr
                    gmx := math.max(gmx, fG(b, x, ters))
                if mx > vh + 0.25 * Ab or gmx > vh + D_FITIL * Ab
                    continue
                float to_ = D_TEMIZ * math.min(hL, hR)
                float tb_ = D_TEMIZ * yuk
                if not (bacakTemiz(b, xl, x1, true, to_, ters) and bacakTemiz(b, x1, xh, false, tb_, ters) and bacakTemiz(b, xh, x2, true, tb_, ters) and bacakTemiz(b, x2, xr, false, to_, ters))
                    continue
                if not onceOk(b, xl, vl, yuk, math.max(int(gen / 2), 20), Ab, D_ONCOBO, ters)
                    continue
                if tekMum(b, xl, x1, vl - v1) or tekMum(b, x1, xh, vh - v1) or tekMum(b, xh, x2, vh - v2) or tekMum(b, x2, xr, vr - v2)
                    continue
                bul := true
                rxl := xl
                rx1 := x1
                rxh := xh
                rx2 := x2
                rxr := xr
                ryuk := yuk
                break
            if bul
                break
    [bul, rxl, rx1, rxh, rx2, rxr, ryuk]

