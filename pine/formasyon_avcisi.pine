     67.0, 78.0, 65.0, 61.0, 63.0, 71.0, 78.0, 86.0, 100.0, 0.0, 53.0, 0.0, 54.0, 60.0, 62.0, 60.0, 0.0, 69.0, 57.0, 65.0,
     38.0, 52.0, 46.0, 44.0, 71.0, 37.0, 52.0, 67.0, 0.0, 0.0, 67.0, 0.0, 47.0, 44.0, 100.0, 36.0, 0.0, 43.0, 58.0, 33.0,
     43.0, 38.0, 39.0, 35.0, 0.0, 43.0, 38.0, 67.0, 100.0, 0.0, 71.0, 0.0, 42.0, 20.0, 0.0, 32.0, 0.0, 37.0, 33.0, 0.0)
var array<float> stR = array.from(
     0.02, -0.10, 0.41, 0.60, 0.62, -0.01, -0.10, 0.39, 0.20, 0.02, 0.05, 0.00, 0.60, 0.75, 0.64, 0.28, 0.00, 0.32, 0.59, 0.68,
     0.11, 0.09, -0.01, -0.15, -0.31, 0.14, 0.09, 0.27, 0.16, -0.16, 0.06, 0.00, -0.16, -0.26, -0.26, -0.15, 0.00, -0.09, -0.28, -0.38,
     0.07, -0.19, 0.31, 0.53, 0.69, 0.03, -0.19, 0.29, 0.06, -0.33, 0.18, 0.00, 0.44, 0.80, 0.99, 0.17, 0.00, 0.26, 0.51, 0.63,
     0.07, 0.11, -0.12, -0.20, -0.24, 0.13, 0.11, 0.16, -0.02, -0.28, 0.22, 0.00, -0.06, -0.17, -0.23, -0.37, 0.00, -0.24, -0.31, -0.25,
     -0.01, -0.33, 0.11, -0.02, 0.17, -0.00, -0.33, 0.37, -0.71, -0.41, -0.05, 0.00, -0.02, 0.28, 0.56, -0.02, 0.00, 0.11, 0.08, 0.05,
