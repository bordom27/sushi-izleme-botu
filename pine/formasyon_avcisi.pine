var string piyKod = syminfo.type == "crypto" ? "KRIPTO" : syminfo.prefix == "BIST" ? "BIST" : (syminfo.type == "stock" or syminfo.type == "dr" or syminfo.type == "fund") and syminfo.currency == "USD" ? "ABD" : "HEPSI"
var int piyIdx = piyKod == "KRIPTO" ? 1 : piyKod == "BIST" ? 2 : piyKod == "ABD" ? 3 : 0
var int tfSn = timeframe.in_seconds()
// hissede seans 8 saatten kısa: 8 saatlik mum günlük mumla aynı
var int tfIdx = tfSn < 6 * 3600 ? 0 : tfSn < 12 * 3600 ? (piyIdx >= 2 ? 2 : 1) : tfSn < 2 * 86400 ? 2 : tfSn < 5 * 86400 ? 3 : 4
var bool tfTam = tfSn == 4 * 3600 or tfSn == 8 * 3600 or tfSn == 86400 or tfSn == 3 * 86400 or tfSn == 7 * 86400

stIdx(int de, int pi, int tf) => (de * 4 + pi) * 5 + tf
// bu piyasada 30'dan az kırılım varsa tüm piyasaların sonucu kullanılır
stHucre(int de, int tf) =>
    int i = stIdx(de, piyIdx, tf)
    array.get(stN, i) >= 30 ? i : stIdx(de, 0, tf)
derece(int i) =>
    float n = array.get(stN, i)
    float r = array.get(stR, i)
    n < 30 ? "AZ ÖRNEK" : r >= 0.40 ? "GÜÇLÜ" : r >= 0.15 ? "İYİ" : r >= 0 ? "TEMKİNLİ" : "KAÇIN"
dereceIkon(string d) => d == "GÜÇLÜ" or d == "İYİ" ? "🟢" : d == "TEMKİNLİ" ? "🟠" : d == "KAÇIN" ? "🔴" : "⚪"
dereceRenk(string d) => d == "GÜÇLÜ" ? #4caf50 : d == "İYİ" ? #9ccc65 : d == "TEMKİNLİ" ? #ffb74d : d == "KAÇIN" ? #ef5350 : color.gray
dereceNot(string d) => d == "GÜÇLÜ" or d == "İYİ" ? "işlem alınabilir" : d == "TEMKİNLİ" ? "küçük pozisyon, yarım hedefte kâr al" : d == "KAÇIN" ? "işlem alma" : "geçmiş örnek az, güvenme"
rYazi(float r) => (r >= 0 ? "+" : "−") + str.tostring(math.abs(r), "0.00") + "R"
tfAd(int t) => t == 0 ? "4 saatlik" : t == 1 ? "8 saatlik" : t == 2 ? "günlük" : t == 3 ? "3 günlük" : "haftalık"
piyAd(int pk) => pk == 1 ? "kripto" : pk == 2 ? "BIST" : pk == 3 ? "ABD hisseleri" : "tüm piyasalar"
desenNo(string t) => t == "ikili_dip" ? 4 : t == "ikili_tepe" ? 5 : t == "ters_obo" ? 6 : 7
// üçgenin tablo satırı: büyük üçgen ayrı ölçüldü (yukarı kırılımı küçüklerden iyi)
ucgDe(bool yukari) => (fBuyuk ? 0 : 2) + (yukari ? 0 : 1)
ucgAd() => fBuyuk ? "Büyük " + str.lower(fTip) : fTip
// H: log'da taban oranı (×2,35), değilse fiyat farkı; hedefte çarpma / bölme ya da artı / eksi
hYazi(float w) => logOn ? "H (taban oranı) = ×" + str.tostring(math.exp(w), "0.00") : "H (taban yüksekliği) = " + str.tostring(w, format.mintick)
hYaziD(float w) => logOn ? "H (oran) = ×" + str.tostring(math.exp(w), "0.00") : "H (yükseklik) = " + str.tostring(w, format.mintick)
hIslem(bool yukari) => logOn ? (yukari ? "×" : "÷") : (yukari ? "+" : "−")
// "🟢 İYİ: işlem alınabilir · geçmiş %38 hedef, +0.27R/işlem"
guvenSatir(int de) =>
    int i = stHucre(de, tfIdx)
    string d = derece(i)
    array.get(stN, i) <= 0 ? "geçmiş veri yok" : dereceIkon(d) + " " + d + ": " + dereceNot(d) + " · geçmiş %" + str.tostring(array.get(stH, i), "#") + " hedef, " + rYazi(array.get(stR, i)) + "/işlem"
guvenKisa(int de) =>
    int i = stHucre(de, tfIdx)
    derece(i) + " (%" + str.tostring(array.get(stH, i), "#") + ", " + rYazi(array.get(stR, i)) + ")"
// bu formasyonun en kârlı zaman dilimi (en az 30 kırılım; bu piyasada yoksa tüm piyasalar)
enIyiYazi(int de, bool kisa) =>
    int en = -1
    float enR = -99.0
    for tf = 0 to 4
        int i = stIdx(de, piyIdx, tf)
        if array.get(stN, i) >= 30 and array.get(stR, i) > enR
            enR := array.get(stR, i)
            en := i
    if en < 0
        for tf = 0 to 4
            int i = stIdx(de, 0, tf)
            if array.get(stN, i) >= 30 and array.get(stR, i) > enR
                enR := array.get(stR, i)
                en := i
    en < 0 ? "—" : enR < 0 ? (kisa ? "yok" : "hiçbiri kârlı değil") : tfAd(en % 5) + (kisa ? "" : " %" + str.tostring(array.get(stH, en), "#")) + " (" + rYazi(enR) + ")" + (en % 5 == tfIdx ? (kisa ? " ✓" : " ← bu grafik") : "")
kaynakSatir(int de1, int de2) =>
    int i1 = stHucre(de1, tfIdx)
    string n = str.tostring(array.get(stN, i1), "#")
    if de2 >= 0
        n += " / " + str.tostring(array.get(stN, stHucre(de2, tfIdx)), "#")
    "Kaynak: " + piyAd(int(math.floor(i1 / 5)) % 4) + " · " + tfAd(tfIdx) + " grafik" + (tfTam ? "" : " (en yakın test edilen)") + " · " + n + " geçmiş kırılım"

// ───────── kırılım kalitesi (tarayıcıyla aynı) ─────────
// Geçmiş ~8.000 kırılımda sonucu ayıran üç kontrol: R/Ö ≥ 1,25 (giriş kırılım kapanışı, stop geçersizlik, gerçek
// fiyatla) · EMA200 yönünde · BB genişliği ≥ 3,2 ATR (fiyat çizgiye hareketli geliyor; hacim, MACD, RSI, ADX, OBV
// yerine seçildi: yalnız bu her zaman diliminde ayırdı). Gösterilen yargı, bu formasyonun aynı puandaki geçmiş
// kırılımlarından (puan yukarı kırılımlarda belirgin ayırıyor, aşağı kırılımlarda zayıf).
K_RR    = 1.25
K_BB    = 3.2
rrFiyat(float giris, float gec, float hed, bool yuk) =>
    float s = yuk ? 1.0 : -1.0
    float risk = s * (fx(giris) - fx(gec))
    float odul = s * (fx(hed) - fx(giris))
    risk > 0 and odul > 0 ? odul / risk : na
rrMetin(float rr) => na(rr) ? "R/Ö —" : "R/Ö 1 : " + str.tostring(rr, "0.0")
isaret(int d) => d > 0 ? "✓" : d < 0 ? "✗" : "—"
trendDurum(bool yuk) => bar_index < 200 or na(ema200) ? 0 : (yuk ? pC >= ema200 : pC <= ema200) ? 1 : -1
kalPuan(float rr, bool yuk) => (not na(rr) and rr >= K_RR ? 1 : 0) + (trendDurum(yuk) > 0 ? 1 : 0) + (not na(bbGen) and bbGen >= K_BB ? 1 : 0)
kalAyr(float rr, bool yuk) => "R/Ö " + (na(rr) ? "—" : str.tostring(rr, "0.0")) + " " + isaret(not na(rr) and rr >= K_RR ? 1 : -1) + " · trend " + isaret(trendDurum(yuk)) + " · BB " + (na(bbGen) ? "—" : str.tostring(bbGen, "0.0") + " ATR " + isaret(bbGen >= K_BB ? 1 : -1))
// bu formasyonun aynı kalite puanındaki geçmiş kırılımlarının derecesi (30'dan az örnekte boş)
kalDerece(int de, int puan) =>
    int i = (de * 5 + tfIdx) * 3 + (puan >= 3 ? 0 : puan == 2 ? 1 : 2)
    float r = array.get(kalR, i)
    array.get(kalN, i) < 30 ? "" : (r >= 0.40 ? "GÜÇLÜ" : r >= 0.15 ? "İYİ" : r >= 0 ? "TEMKİNLİ" : "KAÇIN") + " (%" + str.tostring(array.get(kalH, i), "#") + ", " + rYazi(r) + ")"
kalSonuc(int de, float rr, bool yuk) =>
    int pu = kalPuan(rr, yuk)
    string d = kalDerece(de, pu)
    "Kalite " + str.tostring(pu) + "/3: " + kalAyr(rr, yuk) + (d == "" ? "" : "\n→ bu durumda geçmiş " + d)
kalKisa(int de, float rr, bool yuk) =>
    int pu = kalPuan(rr, yuk)
    string d = kalDerece(de, pu)
    "Kalite " + str.tostring(pu) + "/3" + (d == "" ? "" : " → " + d)

// yukarı kırılımda hedef yolunda eski tepe (formasyondan önceki 250 mumda giriş ile hedef arasında tepe):
// test ~3.600 yukarı kırılım: varsa +0,62R, yoksa +0,30R (her zaman dilimi ve piyasada aynı yönde)
// çizgiye değen mum: kırılan (üst / boyun) çizgiye ucu 0,3 ATR yakın, kapanışı geçmeyen mum sayısı (yukarı kırılım)
// test ~3.600 yukarı kırılım: ≤10 mum %50 kazanç +0.53R · 11+ mum %43 +0.47R; aşağıda fark yok
degSay(int x0, bool boyunC) =>
    int n = 0
    int m = math.min(bar_index - x0, 400)
    if m > 0
        for k = 1 to m
            int x = bar_index - k
            float lv = boyunC ? dBoyun(x) : ustDeger(x)
            float a = nz(atr14[k])
            if pH[k] - lv >= -0.3 * a and pC[k] - lv <= 0.3 * a
                n += 1
    n
degYazi(int n) => "\nÇizgiye değen mum: " + str.tostring(n) + (n >= 11 ? " ⚠ fazla (11+ geçmişte %43 kazanç)" : " ✓ (≤10 geçmişte %50 kazanç)")
// hacim: kripto ve BIST'te kırılım mumu hacmi ≥1,5× ise hedefe ulaşma ~10 puan yüksek (ABD'de fark yok)
hacYazi() => (piyIdx == 1 or piyIdx == 2) and not na(hacOr) ? "\nHacim: " + str.tostring(hacOr, "#.#") + "×" + (hacOr >= 1.5 ? " ✓ (≥1,5× geçmişte hedefe ulaşma ~10 puan yüksek)" : " (1,5× altı)") : ""
// işlem planı (test ~3.700 yukarı kırılım, günlük+): yarısını giriş→hedef yolunun yarısında sat, stopu girişe çek,
// kalanı 1,5×H'ye taşı → kazanç oranı %47→%58, ort. getiri +11,3%→+10,1%, medyan −3,5%→+5,4%
kismiSev(float giris, float hed, float k) => fx(giris) + k * (fx(hed) - fx(giris))
planKisa(float giris, float hed) => "\n½ sat " + str.tostring(kismiSev(giris, hed, 0.5), format.mintick) + " · kalan " + str.tostring(kismiSev(giris, hed, 1.5), format.mintick)
// aynı büyük üçgen (aynı iki çizgi başlangıcı) ikinci kez kırılırsa: çizgi yeni dipten/tepeden yeniden çizilmiştir.
// test (günlük+): sahte ▼ sonrası ▲ +0.46R %49 · aynı yönde tekrar ▲ +0.43R %53 · ilk ▲ +0.56R
var array<int> kbU = array.new<int>()
var array<int> kbL = array.new<int>()
var array<bool> kbY = array.new<bool>()
tekrarBul(int u0, int l0) =>
    int r = 0
    int n = array.size(kbU)
    if n > 0
        for i = n - 1 to 0
            if array.get(kbU, i) == u0 and array.get(kbL, i) == l0
                r := array.get(kbY, i) ? 1 : -1
                break
    r
tekrarKisa(int t, bool yuk) => t == 0 ? "" : "\n2. kırılım" + ((t > 0) != yuk ? " (önceki " + (t > 0 ? "▲" : "▼") + " sahte)" : " (aynı yönde)")
tekrarUzun(int t, bool yuk) => t == 0 ? "" : "\n2. KIRILIM: bu üçgen daha önce " + (t > 0 ? "▲ yukarı" : "▼ aşağı") + " kırılmıştı" + ((t > 0) != yuk ? ", o kırılım sahte çıktı; çizgi yeni " + (t > 0 ? "tepeden" : "dipten") + " yeniden çizildi" : "") + (yuk ? " (geçmiş: ▲ tekrar +0.43/+0.46R · ilk ▲ +0.56R)" : " (geçmiş: ▼ tekrar −0.05/−0.20R)")
planYazi(float giris, float hed) => "\n½ sat: " + str.tostring(kismiSev(giris, hed, 0.5), format.mintick) + " (yolun yarısı) → stop girişe\nKalan hedef: " + str.tostring(kismiSev(giris, hed, 1.5), format.mintick) + " (1,5×H)"
var line ksL1 = na
var line ksL2 = na
var label ksT1 = na
var label ksT2 = na
var float ksY1 = na
var float ksY2 = na
var int ksBar = na
planCiz(int b0, float giris, float hed, bool yuk, line o1, line o2, label o3, label o4) =>
    float y1 = kismiSev(giris, hed, 0.5)
    float y2 = kismiSev(giris, hed, 1.5)
    line.delete(o1)
    line.delete(o2)
    label.delete(o3)
    label.delete(o4)
    line l1 = line.new(b0, y1, b0 + 30, y1, color = color.yellow, style = line.style_dotted, width = 1)
    line l2 = line.new(b0, y2, b0 + 30, y2, color = yuk ? color.lime : color.red, style = line.style_dotted, width = 1)
    label t1 = label.new(b0 + 30, y1, "½ sat → stop girişe", style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.yellow, size = size.tiny)
    label t2 = label.new(b0 + 30, y2, "kalan hedef 1,5×H", style = label.style_label_left, color = color.new(color.black, 100), textcolor = yuk ? color.lime : color.red, size = size.tiny)
    [l1, l2, t1, t2]
eskiTepeYazi(float ext, float hed) => na(ext) ? "" : "\nHedef yolunda eski tepe: " + (ext > pC and ext < hed ? "var ✓ (geçmişte +0.62R)" : "yok (geçmişte +0.30R)")

// ───────── bu grafiğin geçmiş başarısı ─────────
// Bu grafikte bulunan her kırılım izlenir: hedef, geçersizlikten önce en fazla 100 mumda gelirse başarılı
// (tarayıcıdaki istatistikle aynı ölçü). 100 mumda ikisi de olmazsa sayılmaz.
var array<int>   tkB = array.new<int>()
var array<float> tkH = array.new<float>()
var array<float> tkG = array.new<float>()
var array<bool>  tkY = array.new<bool>()
var int tkN = 0
var int tkOk = 0
takipEkle(bool yuk, float hed, float gec) =>
    array.push(tkB, bar_index)
    array.push(tkH, hed)
    array.push(tkG, gec)
    array.push(tkY, yuk)
tfKod(int t) => t == 0 ? "4S" : t == 1 ? "8S" : t == 2 ? "G" : t == 3 ? "3G" : "H"
// bu sembolün tüm formasyonlarda en iyi zaman dilimi (tarayıcı istatistiği, semT tablosu)
semMetni() =>
    string t0 = str.replace(syminfo.ticker, ".P", "")
    string pk = piyIdx == 1 ? "K:" : piyIdx == 2 ? "B:" : piyIdx == 3 ? "A:" : ""
    string r = ""
    if pk != ""
        for k = 0 to 1
            string anah = ";" + pk + (k == 0 ? t0 : t0 + "T") + "="
            for i = 0 to array.size(semT) - 1
                string t = array.get(semT, i)
                int ps = str.pos(t, anah)
                if not na(ps)
                    string kalan = str.substring(t, ps + str.length(anah))
                    int e = str.pos(kalan, ";")
                    r := na(e) ? kalan : str.substring(kalan, 0, e)
                    break
            if r != "" or not str.endswith(t0, "USD")
                break
    r
semYazi() =>
    string r = semMetni()
    string canli = tkN > 0 ? "bu grafik %" + str.tostring(100.0 * tkOk / tkN, "#") + " (" + str.tostring(tkN) + ")" : "bu grafikte sonuçlanan kırılım yok"
    string en = ""
    if r == "-"
        en := " · hiçbir zaman dilimi kârlı değil"
    else if r != "" and r != "?"
        array<string> pr = str.split(r, ",")
        if array.size(pr) == 3
            string kod = array.get(pr, 0)
            en := " · en iyi: " + kod + " %" + array.get(pr, 1) + " (" + array.get(pr, 2) + ")" + (tfTam and kod == tfKod(tfIdx) ? " ✓" : "")
    canli + en

kullan(array<int> xs, array<bool> ts) =>
    if array.size(xs) > 0
        for i = 0 to array.size(xs) - 1
            array.push(kulX, array.get(xs, i))
            array.push(kulT, array.get(ts, i))
    while array.size(kulX) > 200
        array.shift(kulX)
        array.shift(kulT)

// pivotları kaydet (fiyat: mumun çizgi ucu)
bool yh = not na(phv)
bool yl = not na(plv)
if yh
    array.push(phB, bar_index - pvN)
    array.push(phP, ucT[pvN])
    array.push(phPB, ucTB[pvN])
if yl
    array.push(plB, bar_index - pvN)
    array.push(plP, ucD[pvN])
    array.push(plPB, ucDB[pvN])
if array.size(phB) > 60
    array.shift(phB)
    array.shift(phP)
    array.shift(phPB)
if array.size(plB) > 60
    array.shift(plB)
    array.shift(plP)
    array.shift(plPB)

// geçici pivotlar (yalnız büyük üçgen): son pvN mum içinde, en az SAG mum önce; solundaki pvN mumdan yüksek
// (alçak), sağındakilerden aşağıda (yukarıda) değil. Kırılımdan hemen önceki son dokunuş onay beklemeden sayılır.
array<int>   gtHB = array.new<int>()
array<float> gtHP = array.new<float>()
array<int>   gtLB = array.new<int>()
array<float> gtLP = array.new<float>()
bool gh = false
bool gl = false
if buyukOn and pvN - 1 >= SAG and bar_index > 2 * pvN and bar_index >= last_bar_index - B_GECMIS
    for k = pvN - 1 to SAG
        bool okH = true
        bool okL = true
        for j = 1 to pvN
            if high[k + j] >= high[k]
                okH := false
            if low[k + j] <= low[k]
                okL := false
        for j = 0 to k - 1
            if high[j] > high[k]
                okH := false
            if low[j] < low[k]
                okL := false
        if okH
            array.push(gtHB, bar_index - k)
            array.push(gtHP, ucTB[k])
            if k == SAG
                gh := true
        if okL
            array.push(gtLB, bar_index - k)
            array.push(gtLP, ucDB[k])
            if k == SAG
                gl := true

// bayatlamış üçgen (salınım geçmişi MAXOMUR mumla sınırlı)
if aktif and bar_index - fx0 > MAXOMUR
    array.push(bozuk, fKey)
    array.push(kulX, uI0)
    array.push(kulT, true)
    array.push(kulX, lI0)
    array.push(kulT, false)
    aktif := false

int b = bar_index
float Ab = atr14
float tol = tolAtr * atr14
if array.size(tkB) > 0
    for i = array.size(tkB) - 1 to 0
        int bi = array.get(tkB, i)
        if b > bi
            bool yk = array.get(tkY, i)
            bool bozuldu = yk ? pL <= array.get(tkG, i) : pH >= array.get(tkG, i)
            bool vardi = yk ? pH >= array.get(tkH, i) : pL <= array.get(tkH, i)
            if bozuldu or vardi or b - bi >= 100
                if bozuldu or vardi
                    tkN += 1
                    tkOk += vardi and not bozuldu ? 1 : 0
                array.remove(tkB, i)
                array.remove(tkH, i)
                array.remove(tkG, i)
                array.remove(tkY, i)
bool onayPiv = yh or yl
bool yeniPiv = (onayPiv or gh or gl) and atr14 > 0

// geçmiş dizileri (yalnızca yeni pivotta)
if yeniPiv
    int lim = math.min(math.max(math.max(math.max(maxBar, DIZI), buyukOn ? MAXOMUR : 0), aktif ? b - fx0 : 0), MAXOMUR)
    array.clear(aT)
    array.clear(aD)
    array.clear(aTB)
    array.clear(aDB)
    array.clear(aA)
    array.clear(aH)
    array.clear(aL)
    array.clear(aO)
    array.clear(aC)
    for k = 0 to lim
        array.push(aT, ucT[k])
        array.push(aD, ucD[k])
        array.push(aTB, ucTB[k])
        array.push(aDB, ucDB[k])
        array.push(aA, atr14[k])
        array.push(aH, pH[k])
        array.push(aL, pL[k])
        array.push(aO, pO[k])
        array.push(aC, pC[k])

// 1) dönüş adayı: yeni tepe → OBO / ikili tepe, yeni dip → ters OBO / ikili dip
if yeniPiv
    for q = 0 to 1
        bool ters = q == 1
        bool var_ = ters ? yl : yh
        if var_
            array<int> piv = ters ? plB : phB
            float sg = ters ? -1.0 : 1.0
            bool bul = false
            string tur = ""
            array<int>   px = array.new<int>()
            array<bool>  pt = array.new<bool>()
            float yuk = na
            if showObo
                [ok1, xl, x1, xh, x2, xr, y1] = oboBul(b, piv, ters, Ab)
                if ok1
                    bul := true
                    tur := ters ? "ters_obo" : "obo"
                    yuk := y1
                    array.push(px, xl)
                    array.push(px, x1)
                    array.push(px, xh)
                    array.push(px, x2)
                    array.push(px, xr)
            if not bul and showIk
                [ok2, j1, jt, j2, y2] = ikiliBul(b, piv, ters, Ab)
                if ok2
                    bul := true
                    tur := ters ? "ikili_dip" : "ikili_tepe"
                    yuk := y2
                    array.push(px, j1)
                    array.push(px, jt)
                    array.push(px, j2)
            if bul
                for i = 0 to array.size(px) - 1
                    array.push(pt, ters ? i % 2 == 1 : i % 2 == 0)
                if not cakisir(px, pt, kulX, kulT)
                    aVar := true
                    aTur := tur
                    aTers := ters
                    aYuk := yuk
                    aGen := array.get(px, array.size(px) - 1) - array.get(px, 0)
                    array.clear(aPX)
                    array.clear(aPP)
                    array.clear(aPT)
                    for i = 0 to array.size(px) - 1
                        int xi = array.get(px, i)
                        array.push(aPX, xi)
                        array.push(aPT, array.get(pt, i))
                        // gerçek fiyat: tepe noktası → tepe ucu, dip noktası → dip ucu (ters çerçevede ters)
                        bool tepeNok = i % 2 == 0
                        array.push(aPP, sg * (tepeNok ? fU(b, xi, ters) : fA(b, xi, ters)))
                    if array.size(px) == 3
                        aBi0 := array.get(px, 1)
                        aBp0 := array.get(aPP, 1)
                        aBs := 0.0
                        aGec := sg * math.max(sg * array.get(aPP, 0), sg * array.get(aPP, 2))
                    else
                        aBi0 := array.get(px, 1)
                        aBp0 := array.get(aPP, 1)
                        aBs := (array.get(aPP, 3) - array.get(aPP, 1)) / (array.get(px, 3) - array.get(px, 1))
                        aGec := array.get(aPP, 4)
                    aKey := tur + "_" + str.tostring(array.get(px, 0)) + "_" + str.tostring(array.get(px, array.size(px) - 1))

// üçgen olayları: kırılım / son, mevcut çizgilere göre (çizgiler kırılım mumunda yeniden çizilmez)
bool evYakU = false
bool evYakL = false
bool evKirU = false
bool evKirL = false
float kirSev = na
float kirHedef = na
string kirAd = ""
string kirGuv = ""
string kirKal = ""
float up = na
float lw = na
if aktif
    up := ustDeger(b)
    lw := altDeger(b)
    if b >= fApex or b - fx0 > MAXOMUR
        array.push(bozuk, fKey)
        array.push(kulX, uI0)
        array.push(kulT, true)
        array.push(kulX, lI0)
        array.push(kulT, false)
        aktif := false
    else if pC > up + (fBuyuk ? math.max(tol, B_KIRH * fw0) : tol) or pC < lw - (fBuyuk ? math.max(tol, B_KIRH * fw0) : tol)
        evKirU := pC > up
        evKirL := not evKirU
        kirSev := evKirU ? up : lw
        kirHedef := evKirU ? up + fw0 : lw - fw0
        kirAd := ucgAd()
        kirGuv := guvenKisa(ucgDe(evKirU))
        float rrK = rrFiyat(pC, evKirU ? lw : up, kirHedef, evKirU)
        int tkr = fBuyuk ? tekrarBul(uI0, lI0) : 0
        array.push(kbU, uI0)
        array.push(kbL, lI0)
        array.push(kbY, evKirU)
        if array.size(kbU) > 200
            array.shift(kbU)
            array.shift(kbL)
            array.shift(kbY)
        float extK = na
        if evKirU and b - fx0 + 1 <= 250
            for k = b - fx0 + 1 to math.min(250, b)
                extK := math.max(nz(extK, pH[k]), pH[k])
        kirKal := kalKisa(ucgDe(evKirU), rrK, evKirU)
        takipEkle(evKirU, kirHedef, evKirU ? lw : up)
        if evKirU
            [pl1, pl2, pt1, pt2] = planCiz(b, pC, kirHedef, evKirU, ksL1, ksL2, ksT1, ksT2)
            ksL1 := pl1
            ksL2 := pl2
            ksT1 := pt1
            ksT2 := pt2
            ksY1 := kismiSev(pC, kirHedef, 0.5)
            ksY2 := kismiSev(pC, kirHedef, 1.5)
            ksBar := b
        array.push(bozuk, fKey)
        array.push(kulX, uI0)
        array.push(kulT, true)
        array.push(kulX, lI0)
        array.push(kulT, false)
        aktif := false
        if gecmis
            line.new(uI0, fx(ustDeger(uI0)), b, fx(up), color = color.new(cUst, 30), width = 1)
            line.new(lI0, fx(altDeger(lI0)), b, fx(lw), color = color.new(cAlt, 30), width = 1)
            label.new(b, evKirU ? high : low, (evKirU ? "▲ YUKARI KIRILIM" : "▼ AŞAĞI KIRILIM") + tekrarKisa(tkr, evKirU) + "\n" + ucgAd() + " üçgen · hedef " + str.tostring(fx(kirHedef), format.mintick) + "\nGüven: " + guvenKisa(ucgDe(evKirU)) + "\n" + kalKisa(ucgDe(evKirU), rrK, evKirU) + (evKirU ? planKisa(pC, kirHedef) : ""), style = evKirU ? label.style_label_down : label.style_label_up, color = evKirU ? color.new(color.green, 10) : color.new(color.red, 10), textcolor = color.white, size = size.small, tooltip = (evKirU ? "▲ YUKARI KIRILIM\n" : "▼ AŞAĞI KIRILIM\n") + ucgAd() + " üçgen\nKırılan seviye: " + str.tostring(fx(kirSev), format.mintick) + "\n" + hYazi(fw0) + "\nHedef = seviye " + hIslem(evKirU) + " H = " + str.tostring(fx(kirHedef), format.mintick) + "\nGüven: " + guvenKisa(ucgDe(evKirU)) + "\n" + kalSonuc(ucgDe(evKirU), rrK, evKirU) + hfYazi(evKirU) + eskiTepeYazi(extK, kirHedef) + (evKirU ? degYazi(degSay(fx0, false)) : "") + hacYazi() + (evKirU ? planYazi(pC, kirHedef) : "") + tekrarUzun(tkr, evKirU))
    else
        if up - pC <= yakAtr * atr14 and not yakU
            yakU := true
            evYakU := true
        if pC - lw <= yakAtr * atr14 and not yakL
            yakL := true
            evYakL := true
// dönüş olayları: mevcut boyuna göre (yeni formasyon eskisinin onayını yutmasın)
bool evBoyYak = false
bool evOnay = false
string onayTur = ""
bool onayYukari = false
float onaySev = na
float onayHedef = na
string onayKal = ""
if dVar
    float nl = dBoyun(b)
    bool asagi = not dTers
    int sonX = array.get(dPX, array.size(dPX) - 1)
    if (asagi and pC > dGec + tol) or (not asagi and pC < dGec - tol)
        kullan(dPX, dPT)
        dVar := false
    else if b - sonX > math.max(15, D_OMUR * dGen)
        kullan(dPX, dPT)
        dVar := false
    else if (asagi and pC < nl - tol) or (not asagi and pC > nl + tol)
        evOnay := true
        onayTur := dTur
        onayYukari := not asagi
        onaySev := nl
        onayHedef := asagi ? nl - dYuk : nl + dYuk
        float rrO = rrFiyat(pC, dGec, onayHedef, not asagi)
        float extO = na
        int x0O = array.get(dPX, 0)
        if not asagi and b - x0O + 1 <= 250
            for k = b - x0O + 1 to math.min(250, b)
                extO := math.max(nz(extO, pH[k]), pH[k])
        onayKal := kalKisa(desenNo(dTur), rrO, not asagi)
        takipEkle(not asagi, onayHedef, dGec)
        if not asagi
            [pl1, pl2, pt1, pt2] = planCiz(b, pC, onayHedef, not asagi, ksL1, ksL2, ksT1, ksT2)
            ksL1 := pl1
            ksL2 := pl2
            ksT1 := pt1
            ksT2 := pt2
            ksY1 := kismiSev(pC, onayHedef, 0.5)
            ksY2 := kismiSev(pC, onayHedef, 1.5)
            ksBar := b
        if gecmis
            int bx1 = array.get(dPX, 1)
            line.new(bx1, fx(dBoyun(bx1)), b, fx(nl), color = color.new(cBoyun, 25), width = 1)
            if array.size(dPX) == 3
                line.new(array.get(dPX, 0), fx(array.get(dPP, 0)), array.get(dPX, 2), fx(array.get(dPP, 2)), color = color.new(asagi ? color.red : color.teal, 35), width = 1)
            label.new(b, asagi ? low : high, (asagi ? "▼ " : "▲ ") + str.upper(desenAd(dTur)) + " · hedef " + str.tostring(fx(onayHedef), format.mintick) + "\nGüven: " + guvenKisa(desenNo(dTur)) + "\n" + kalKisa(desenNo(dTur), rrO, not asagi) + (not asagi ? planKisa(pC, onayHedef) : ""), style = asagi ? label.style_label_up : label.style_label_down, color = asagi ? color.new(color.red, 10) : color.new(color.green, 10), textcolor = color.white, size = size.small, tooltip = (asagi ? "▼ " : "▲ ") + str.upper(desenAd(dTur)) + "\nOnay: " + str.tostring(fx(nl), format.mintick) + "\nHedef: " + str.tostring(fx(onayHedef), format.mintick) + "\nGüven: " + guvenKisa(desenNo(dTur)) + "\n" + kalSonuc(desenNo(dTur), rrO, not asagi) + hfYazi(not asagi) + eskiTepeYazi(extO, onayHedef) + (not asagi ? degYazi(degSay(x0O, true)) : "") + hacYazi() + (not asagi ? planYazi(pC, onayHedef) : ""))
        kullan(dPX, dPT)
        dVar := false
    else if not dYakin and math.abs(pC - nl) <= yakAtr * atr14
        dYakin := true
        evBoyYak := true

// 2) üçgen: her yeni pivotta yeniden kur (Python: formasyon_kur). Önce büyük üçgen aranır (elle çizen gibi);
//    bulunursa içindeki küçük üçgenler gösterilmez. Büyük üçgen geçerli kaldıkça çizgileri sabit kalır.
// Python: hala_gecerli — kapanışlar içeride ve salınımlar hâlâ çizgilere değiyor mu
gecerliMi(int b, float tol) =>
    bool g = true
    for x = fx0 to b
        float cx = array.get(aC, b - x)
        if cx - ustDeger(x) > tol or altDeger(x) - cx > tol
            g := false
            break
        // büyük üçgen: yeni bir dip / tepe çizgiyi deldiyse çizgi yeniden çizilir (elle çizen gibi)
        if fBuyuk and (array.get(aTB, b - x) - ustDeger(x) > tol or altDeger(x) - array.get(aDB, b - x) > tol)
            g := false
            break
    if g
        [ih2, ud2, ad2, yk2] = salinim(fx0, b, uI0, uP0, uS, lI0, lP0, lS, uI0 <= lI0, false, ckX, ckU, fBuyuk)
        g := ih2 == 0
    g

if yeniPiv
    bool surer = aktif and fBuyuk and gecerliMi(b, tol)     // büyük üçgen sürüyor: çizgiler sabit
    bool bulundu = false
    bool bB = false
    int bU = -1
    int bL = -1
    float bW0 = na
    float bApex = na
    string bTip = ""
    int bDok = 0
    string key = ""
    if not surer
        array.clear(sufH)
        array.clear(sufL)
        float mh = pH
        float ml = pL
        int kmax = math.min(math.max(maxBar, buyukOn ? B_MAXBAR : 0), array.size(aH) - 1)
        for k = 0 to kmax
            mh := math.max(mh, nz(array.get(aH, k), mh))
            ml := math.min(ml, nz(array.get(aL, k), ml))
            array.push(sufH, mh)
            array.push(sufL, ml)
        array<int>   tHB = array.concat(array.copy(phB), gtHB)    // büyük üçgen: onaylı + geçici pivotlar
        array<float> tHP = array.concat(array.copy(phPB), gtHP)
        array<int>   tLB = array.concat(array.copy(plB), gtLB)
        array<float> tLP = array.concat(array.copy(plPB), gtLP)
        for q = 0 to 1
            bool B = q == 0
            if B and (not buyukOn or b < last_bar_index - B_GECMIS)
                continue
            if not B and not onayPiv                               // küçük üçgen yalnız onaylı pivotla kurulur
                break
            int mBar = B ? B_MAXBAR : maxBar
            int mnBar = B ? B_MINBAR : minBar
            float dng = B ? B_DENGE : DENGE
            array<int> hB = B ? tHB : phB
            array<int> lB_ = B ? tLB : plB
            int jh = cizgiAdaylari(hB, B ? tHP : phP, b, tol, true, cuI, cuP, cuS, cuF, mBar, B ? B_MAXP : MAXP, B)
            int jl = cizgiAdaylari(lB_, B ? tLP : plP, b, tol, false, clI, clP, clS, clF, mBar, B ? B_MAXP : MAXP, B)
            float enSkor = na
            int eU = -1
            int eL = -1
            float eW0 = na
            float eApex = na
            string eTip = ""
            int eDok = 0
            if array.size(hB) - jh >= 2 and array.size(lB_) - jl >= 2 and array.size(cuI) > 0 and array.size(clI) > 0
                for iu = 0 to array.size(cuI) - 1
                    for il = 0 to array.size(clI) - 1
                        int ui0 = array.get(cuI, iu)
                        float up0 = array.get(cuP, iu)
                        float us = array.get(cuS, iu)
                        int li0 = array.get(clI, il)
                        float lp0 = array.get(clP, il)
                        float ls = array.get(clS, il)
                        int x0 = math.min(ui0, li0)
                        int sure = b - x0
                        bool ok = sure >= mnBar and sure <= mBar and sure < array.size(sufH) and math.abs(ui0 - li0) <= dng * sure and array.get(cuF, iu) <= x0 and array.get(clF, il) <= x0
                        ok := ok and math.abs(ui0 - li0) >= pvN          // iki çizgi aynı mumdan çıkmasın
                        float w0 = na
                        float wb = na
                        string tip = ""
                        if ok
                            w0 := (up0 + us * (x0 - ui0)) - (lp0 + ls * (x0 - li0))
                            wb := (up0 + us * (b - ui0)) - (lp0 + ls * (b - li0))
                            ok := w0 > 0 and wb > 0 and wb / w0 <= darMax and w0 >= minYuk * atr14
                        if ok
                            float du = us * (b - x0) / w0
                            float dl = ls * (b - x0) / w0
                            tip := du < -yatay and dl > yatay ? "Simetrik" : math.abs(du) <= yatay and dl > yatay ? "Yükselen" : du < -yatay and math.abs(dl) <= yatay ? "Alçalan" : ""
                            ok := tip != ""
                        if ok
                            ok := (up0 + us * (x0 - ui0)) <= array.get(sufH, sure) + TASMA * w0 and (lp0 + ls * (x0 - li0)) >= array.get(sufL, sure) - TASMA * w0
                        if ok and B
                            // ikinci çizgi üçgen %25'ten fazla daralmadan başlamalı
                            ok := math.abs(ui0 - li0) <= B_DAPEX * w0 / (w0 - wb) * sure
                        if ok and B
                            // giriş hareketi ≥ taban: üçgen güçlü bir hareketin ardındaki sıkışma
                            int a0 = math.max(0, x0 - math.max(mnBar, int(sure / 2)), b - (array.size(aL) - 1))
                            if a0 >= x0
                                ok := false
                            else
                                float ext = ui0 <= li0 ? 1e10 : -1e10
                                for x = a0 to x0 - 1
                                    ext := ui0 <= li0 ? math.min(ext, array.get(aL, b - x)) : math.max(ext, array.get(aH, b - x))
                                float giris = ui0 <= li0 ? (up0 + us * (x0 - ui0)) - ext : ext - (lp0 + ls * (x0 - li0))
                                ok := giris >= B_ONCEKI * w0
                        if ok
                            [ih, ud, ad, yk] = salinim(x0, b, ui0, up0, us, li0, lp0, ls, ui0 <= li0, false, ckX, ckU, B)
                            if ih == 0 and ud >= minDok and ad >= minDok
                                // büyük: önce en büyük yapı (taban), sonra dokunuş ve süre; küçük: en çok dokunuş,
                                // eşitlikte derli toplu (kısa)
                                float skor = B ? B_PUANW * w0 + ud + ad - 0.25 * yk + sure / mBar : ud + ad - 0.5 * yk - 0.25 * sure / mBar
                                if na(enSkor) or skor > enSkor
                                    enSkor := skor
                                    eU := iu
                                    eL := il
                                    eW0 := w0
                                    eApex := x0 + w0 / (w0 - wb) * sure
                                    eTip := tip
                                    eDok := ud + ad
            if eU >= 0
                // büyük üçgende anahtar eğimleri de içerir: kırılım sonrası fiyat dönüp yeni tepe / dip yaparsa
                // aynı noktalardan yeniden çizilen (elle düzeltilen) üçgen yeni sayılır
                string k_ = str.tostring(array.get(cuI, eU)) + "_" + str.tostring(array.get(clI, eL))
                if B
                    k_ += "_" + str.tostring(array.get(cuS, eU), "#.##########") + "_" + str.tostring(array.get(clS, eL), "#.##########")
                bool ok_ = true
                if not (aktif and fKey == k_)
                    array<int>  bx = array.from(array.get(cuI, eU), array.get(clI, eL))
                    array<bool> bt = array.from(true, false)
                    if array.includes(bozuk, k_) or (not B and cakisir(bx, bt, kulX, kulT))
                        ok_ := false
                if ok_
                    bulundu := true
                    bB := B
                    bU := eU
                    bL := eL
                    bW0 := eW0
                    bApex := eApex
                    bTip := eTip
                    bDok := eDok
                    key := k_
                    break
    if bulundu
        int ui0 = array.get(cuI, bU)
        int li0 = array.get(clI, bL)
        [c1, c2, c3, c4] = salinim(math.min(ui0, li0), b, ui0, array.get(cuP, bU), array.get(cuS, bU), li0, array.get(clP, bL), array.get(clS, bL), ui0 <= li0, true, ckX, ckU, bB)
        if dVar and cakisir(ckX, ckU, dPX, dPT)
            if oncelik(dTur) >= 2
                bulundu := false
            else
                dVar := false                                  // üçgen ikili tepe/dibi devirir
    if bulundu
        if not (aktif and fKey == key)
            yakU := false
            yakL := false
        aktif := true
        fBuyuk := bB
        uI0 := array.get(cuI, bU)
        uP0 := array.get(cuP, bU)
        uS := array.get(cuS, bU)
        lI0 := array.get(clI, bL)
        lP0 := array.get(clP, bL)
        lS := array.get(clS, bL)
        fx0 := math.min(uI0, lI0)
        fw0 := bW0
        fApex := bApex
        fTip := bTip
        fDok := bDok
        fKey := key
        array.clear(dkX)
        array.clear(dkU)
        for i = 0 to array.size(ckX) - 1
            array.push(dkX, array.get(ckX, i))
            array.push(dkU, array.get(ckU, i))
    else if aktif and not surer and (onayPiv or fBuyuk)
        if not gecerliMi(b, tol)
            array.push(bozuk, fKey)
            array.push(kulX, uI0)
            array.push(kulT, true)
            array.push(kulX, lI0)
            array.push(kulT, false)
            aktif := false

// 3) dönüş adayı onaylandı mı: son noktadan yeterince uzaklaştı, boyun henüz kırılmadı
if aVar
    if b - array.get(aPX, array.size(aPX) - 1) > MAXOMUR
        aVar := false
if aVar and not (dVar and oncelik(dTur) >= oncelik(aTur))
    int sx = array.get(aPX, array.size(aPX) - 1)
    float sonP = array.get(aPP, array.size(aPP) - 1)
    float nlB = aBoyun(b)
    float uzak = 0.0
    bool bozukMu = false
    if not aTers
        float mnL = pL
        float mxC = pC
        for x = sx to b
            mnL := math.min(mnL, pL[b - x])
            mxC := math.max(mxC, pC[b - x])
        uzak := sonP - mnL
        bozukMu := mxC > aGec + tol or pC < nlB - tol
    else
        float mxH = pH
        float mnC = pC
        for x = sx to b
            mxH := math.max(mxH, pH[b - x])
            mnC := math.min(mnC, pC[b - x])
        uzak := mxH - sonP
        bozukMu := mnC < aGec - tol or pC > nlB + tol
    if bozukMu
        aVar := false
    else if uzak >= math.max(D_ONAYA * Ab, D_ONAY * aYuk)
        if aktif and cakisir(aPX, aPT, dkX, dkU)
            if oncelik(aTur) > 2
                aktif := false                                 // OBO üçgeni devirir
            else
                aVar := false
        if aVar
            dVar := true
            dTur := aTur
            dTers := aTers
            dYuk := aYuk
            dGen := aGen
            dGec := aGec
            dBi0 := aBi0
            dBp0 := aBp0
            dBs := aBs
            dKey := aKey
            dYakin := false
            array.clear(dPX)
            array.clear(dPP)
            array.clear(dPT)
            for i = 0 to array.size(aPX) - 1
                array.push(dPX, array.get(aPX, i))
                array.push(dPP, array.get(aPP, i))
                array.push(dPT, array.get(aPT, i))
            aVar := false

while array.size(bozuk) > 50
    array.shift(bozuk)
while array.size(kulX) > 200
    array.shift(kulX)
    array.shift(kulT)

plotshape(evYakU, "Üçgen: üst kırılıma yakın", shape.triangleup, location.abovebar, color.new(color.orange, 0), size = size.tiny, text = "YAKIN", textcolor = color.orange)
plotshape(evYakL, "Üçgen: alt kırılıma yakın", shape.triangledown, location.belowbar, color.new(color.blue, 0), size = size.tiny, text = "YAKIN", textcolor = color.blue)
plotshape(evBoyYak, "Boyun çizgisine yakın", shape.diamond, location.abovebar, color.new(#ffd54f, 0), size = size.tiny, text = "BOYUN", textcolor = #ffd54f)

// ───────── alarmlar ─────────
alertcondition(evYakU, "Üçgen: üst kırılıma yakın", "{{ticker}} daralan üçgende üst çizgiye yaklaştı ({{interval}})")
alertcondition(evYakL, "Üçgen: alt kırılıma yakın", "{{ticker}} daralan üçgende alt çizgiye yaklaştı ({{interval}})")
alertcondition(evKirU, "Üçgen: YUKARI KIRILIM", "{{ticker}} daralan üçgeni YUKARI kırdı ({{interval}})")
alertcondition(evKirL, "Üçgen: AŞAĞI KIRILIM", "{{ticker}} daralan üçgeni AŞAĞI kırdı ({{interval}})")
alertcondition(evBoyYak, "Dönüş: boyun çizgisine yakın", "{{ticker}} ikili tepe/dip veya OBO boyun çizgisine yaklaştı ({{interval}})")
alertcondition(evOnay and not onayYukari, "Dönüş: AŞAĞI ONAY (ikili tepe / OBO)", "{{ticker}} ikili tepe veya OBO boyun çizgisini aşağı kırdı ({{interval}})")
alertcondition(evOnay and onayYukari, "Dönüş: YUKARI ONAY (ikili dip / ters OBO)", "{{ticker}} ikili dip veya ters OBO boyun çizgisini yukarı kırdı ({{interval}})")
if barstate.isconfirmed
    if evYakU or evYakL
        alert(syminfo.ticker + " " + ucgAd() + " üçgen: " + (evYakU ? "ÜST" : "ALT") + " çizgiye yaklaştı. Üst " + str.tostring(fx(up), format.mintick) + " / alt " + str.tostring(fx(lw), format.mintick), alert.freq_once_per_bar_close)
    if evKirU or evKirL
        alert(syminfo.ticker + (evKirU ? " YUKARI" : " AŞAĞI") + " KIRILIM (" + kirAd + " üçgen). Seviye " + str.tostring(fx(kirSev), format.mintick) + ", hedef " + str.tostring(fx(kirHedef), format.mintick) + ". Güven: " + kirGuv + ". " + kirKal, alert.freq_once_per_bar_close)
    if evBoyYak
        alert(syminfo.ticker + " " + desenAd(dTur) + ": boyun çizgisine yaklaştı (" + str.tostring(fx(dBoyun(b)), format.mintick) + ")", alert.freq_once_per_bar_close)
    if evOnay
        alert(syminfo.ticker + " " + desenAd(onayTur) + " ONAYLANDI. Boyun " + str.tostring(fx(onaySev), format.mintick) + ", hedef " + str.tostring(fx(onayHedef), format.mintick) + ". Güven: " + guvenKisa(desenNo(onayTur)) + ". " + onayKal, alert.freq_once_per_bar_close)

// aktif üçgen: yukarı kırılırsa hedef yolunda eski tepe var mı (formasyondan önceki 250 mum)
string etAktif = "—"
if barstate.islast and aktif and bar_index - fx0 + 1 <= math.min(250, bar_index)
    float extA = na
    for k = bar_index - fx0 + 1 to math.min(250, bar_index)
        extA := math.max(nz(extA, pH[k]), pH[k])
    float girA = ustDeger(bar_index)
    etAktif := extA > girA and extA < girA + fw0 ? "var ✓ (geçmişte +0.62R)" : "yok (geçmişte +0.30R)"

// ───────── aktif formasyonları çiz (son mumda) ─────────
// x: tespit uzayında seviye, c: gerçek fiyat
yuzdeS(float x, float c) =>
    float p = (fx(x) / c - 1) * 100
    (p >= 0 ? "+" : "") + str.tostring(p, "#.#") + "%"

var array<line>  ciz = array.new<line>()
var array<label> etk = array.new<label>()
var linefill lf = na
if barstate.islast
    while array.size(ciz) > 0
        line.delete(array.pop(ciz))
    while array.size(etk) > 0
        label.delete(array.pop(etk))
    linefill.delete(lf)
    if aktif
        // kesik uzantı tepe noktasına (apex) kadar gitmez: iki çizgi tek noktada buluşmasın
        int uc = int(b + math.min(0.6 * (fApex - b), 0.35 * (fApex - fx0)))
        line lU = line.new(uI0, fx(ustDeger(uI0)), b, fx(ustDeger(b)), color = cUst, width = 2)
        line lL = line.new(lI0, fx(altDeger(lI0)), b, fx(altDeger(b)), color = cAlt, width = 2)
        array.push(ciz, lU)
        array.push(ciz, lL)
        array.push(ciz, line.new(b, fx(ustDeger(b)), uc, fx(ustDeger(uc)), color = cUst, width = 1, style = line.style_dashed))
        array.push(ciz, line.new(b, fx(altDeger(b)), uc, fx(altDeger(uc)), color = cAlt, width = 1, style = line.style_dashed))
        lf := linefill.new(lU, lL, color.new(color.gray, 88))
        float olg = (b - fx0) / (fApex - fx0) * 100
        if showHes
            // H = üçgenin başlangıç yüksekliği (ölçülen hareket). Hedef = kırılan çizgi ± H.
            float upN = ustDeger(b)
            float lwN = altDeger(b)
            float tolN = fBuyuk ? math.max(tolAtr * atr14, B_KIRH * fw0) : tolAtr * atr14
            float hU = upN + fw0
            float hA = lwN - fw0
            float rr = math.max(0.0, (fw0 - tolN) / (upN - lwN + tolN))   // giriş kırılım eşiğinde, stop karşı çizgide
            float yA0 = altDeger(fx0)
            float yU0 = ustDeger(fx0)
            array.push(ciz, line.new(fx0, fx(yA0), fx0, fx(yU0), color = color.new(color.silver, 20), width = 1, style = line.style_dotted))
            array.push(etk, label.new(fx0, fx((yA0 + yU0) / 2), "H", style = label.style_label_right, color = color.new(color.black, 100), textcolor = color.silver, size = size.normal))
            array.push(ciz, line.new(b, fx(hU), uc, fx(hU), color = color.green, width = 1, style = line.style_dotted))
            array.push(etk, label.new(uc, fx(hU), "hedef ↑ " + str.tostring(fx(hU), format.mintick) + " (" + yuzdeS(hU, close) + ")", style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.green, size = size.small))
            if logOn or hA > 0
                array.push(ciz, line.new(b, fx(hA), uc, fx(hA), color = color.red, width = 1, style = line.style_dotted))
                array.push(etk, label.new(uc, fx(hA), "hedef ↓ " + str.tostring(fx(hA), format.mintick) + " (" + yuzdeS(hA, close) + ")", style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.red, size = size.small))
            string hes = ucgAd() + " üçgen · " + str.tostring(fDok) + " dokunuş · olgunluk %" + str.tostring(olg, "#") + " · apex'e " + str.tostring(fApex - b, "#") + " mum"
            hes += "\n" + hYazi(fw0) + " · stop: karşı çizgi"
            hes += "\n▲ Üst " + str.tostring(fx(upN), format.mintick) + " (" + yuzdeS(upN, close) + ") · kırılım: kapanış > " + str.tostring(fx(upN + tolN), format.mintick)
            hes += "\n      hedef = " + str.tostring(fx(upN), format.mintick) + " " + hIslem(true) + " H = " + str.tostring(fx(hU), format.mintick) + " (" + yuzdeS(hU, close) + ") · " + rrMetin(rrFiyat(upN + tolN, lwN, hU, true))
            hes += "\n      " + guvenSatir(ucgDe(true))
            hes += "\n▼ Alt " + str.tostring(fx(lwN), format.mintick) + " (" + yuzdeS(lwN, close) + ") · kırılım: kapanış < " + str.tostring(fx(lwN - tolN), format.mintick)
            hes += "\n      hedef = " + str.tostring(fx(lwN), format.mintick) + " " + hIslem(false) + " H = " + (logOn or hA > 0 ? str.tostring(fx(hA), format.mintick) + " (" + yuzdeS(hA, close) + ") · " + rrMetin(rrFiyat(lwN - tolN, upN, hA, false)) : "sıfırın altında (geçersiz)")
            hes += "\n      " + guvenSatir(ucgDe(false))
            hes += "\nEn iyi zaman dilimi: ▲ " + enIyiYazi(ucgDe(true), false) + " · ▼ " + enIyiYazi(ucgDe(false), false)
            hes += "\n▲ Hedef yolunda eski tepe: " + etAktif
            if hfYon != 0
                hes += "\nHaftalık trend: " + (hfYon > 0 ? "▲ yönünde ✓" : "▼ yönünde") + " (günlük ▲ kırılımda yönündeyse +0.38R · değilse +0.20R)"
            hes += "\nSağlam kırılım için: R/Ö ≥ 1.25 · BB ≥ 3.2 ATR (şimdi " + (na(bbGen) ? "—" : str.tostring(bbGen, "0.0")) + ") · ▲ trend " + isaret(trendDurum(true)) + " · ▼ trend " + isaret(trendDurum(false))
            hes += "\n" + kaynakSatir(ucgDe(true), ucgDe(false))
            // kutu üçgenin içinde, geniş tarafta: tabandaki H çizgisinin hemen sağında
            int xk = fx0 + math.max(1, int((b - fx0) * 0.04))
            array.push(etk, label.new(xk, fx((ustDeger(xk) + altDeger(xk)) / 2), hes, style = label.style_label_left, color = color.new(#131722, 25), textcolor = #e0e3eb, size = size.small, textalign = text.align_left))
        else
            array.push(etk, label.new(b, fx(ustDeger(b)), ucgAd() + " üçgen  |  olgunluk %" + str.tostring(olg, "#") + "  |  " + str.tostring(fDok) + " dokunuş", style = label.style_label_lower_left, color = color.new(color.gray, 70), textcolor = color.white, size = size.small))
        if showDok and array.size(dkX) > 0
            for k = 0 to array.size(dkX) - 1
                int xk = array.get(dkX, k)
                bool uk = array.get(dkU, k)
                array.push(etk, label.new(xk, fx(uk ? ustDeger(xk) : altDeger(xk)), "", style = label.style_circle, color = uk ? cUst : cAlt, size = size.tiny))
    if dVar
        bool tepeD = not dTers
        color rk = tepeD ? color.red : color.teal
        int uz = b + math.max(3, int(0.15 * dGen))
        int xb1 = array.get(dPX, 1)
        array.push(ciz, line.new(xb1, fx(dBoyun(xb1)), b, fx(dBoyun(b)), color = cBoyun, width = 2))
        array.push(ciz, line.new(b, fx(dBoyun(b)), uz, fx(dBoyun(uz)), color = cBoyun, width = 1, style = line.style_dashed))
        array.push(etk, label.new(xb1, fx(dBoyun(xb1)), "Boyun", style = tepeD ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = cBoyun, size = size.small))
        if array.size(dPX) == 3
            array.push(ciz, line.new(array.get(dPX, 0), fx(array.get(dPP, 0)), array.get(dPX, 2), fx(array.get(dPP, 2)), color = rk, width = 2))
            for k = 0 to 2 by 2
                array.push(etk, label.new(array.get(dPX, k), fx(array.get(dPP, k)), (k == 0 ? "1. " : "2. ") + (tepeD ? "tepe" : "dip"), style = tepeD ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = rk, size = size.small))
        else
            for k = 0 to 4 by 2
                string ad_ = k == 0 ? "Sol omuz" : k == 2 ? "Baş" : "Sağ omuz"
                array.push(etk, label.new(array.get(dPX, k), fx(array.get(dPP, k)), ad_, style = tepeD ? label.style_label_down : label.style_label_up, color = color.new(rk, 20), textcolor = color.white, size = size.small))
        if showHes
            // boyun, onay eşiği, hedef (boyun ± H), geçersizlik, risk/ödül ve geçmiş güven derecesi
            float nlD = dBoyun(b)
            float tolD = tolAtr * atr14
            float esikD = tepeD ? nlD - tolD : nlD + tolD
            float hedD = tepeD ? nlD - dYuk : nlD + dYuk
            float riskD = math.abs(esikD - dGec)
            float odulD = tepeD ? esikD - hedD : hedD - esikD
            int deD = desenNo(dTur)
            string hd = desenAd(dTur) + " · " + hYaziD(dYuk) + " · onay bekliyor"
            hd += "\nBoyun " + str.tostring(fx(nlD), format.mintick) + " (" + yuzdeS(nlD, close) + ") · onay: kapanış " + (tepeD ? "< " : "> ") + str.tostring(fx(esikD), format.mintick)
            hd += "\nHedef = boyun " + hIslem(not tepeD) + " H = " + (logOn or hedD > 0 ? str.tostring(fx(hedD), format.mintick) + " (" + yuzdeS(hedD, close) + ")" : "sıfırın altında (geçersiz)")
            hd += "\nGeçersizlik " + str.tostring(fx(dGec), format.mintick) + " (" + yuzdeS(dGec, close) + ") · risk/ödül " + (riskD > 0 and odulD > 0 ? "1 : " + str.tostring(odulD / riskD, "#.#") : "—")
            hd += "\n" + guvenSatir(deD)
            hd += "\nEn iyi zaman dilimi: " + enIyiYazi(deD, false)
            hd += "\n" + kaynakSatir(deD, -1)
            array.push(etk, label.new(b, fx(nlD), hd, style = label.style_label_left, color = color.new(#131722, 25), textcolor = #e0e3eb, size = size.small, textalign = text.align_left))
        else
            array.push(etk, label.new(b, fx(dBoyun(b)), desenAd(dTur) + "  |  hedef " + str.tostring(fx(tepeD ? dBoyun(b) - dYuk : dBoyun(b) + dYuk), format.mintick), style = label.style_label_left, color = color.new(rk, 60), textcolor = color.white, size = size.small))

// ───────── panel ─────────
var table tb = table.new(position.top_right, 2, 20, bgcolor = color.new(#131722, 10), border_width = 1, border_color = color.new(color.gray, 70))
satir(int r, string k, string v, color c) =>
    table.cell(tb, 0, r, k, text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tb, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
if showT and barstate.islast
    table.clear(tb, 0, 0, 1, 19)
    table.cell(tb, 0, 0, "FORMASYON AVCISI", text_color = color.white, text_size = size.normal)
    table.cell(tb, 1, 0, timeframe.period, text_color = color.gray, text_size = size.small)
    int r = 1
    if aktif
        float dU = (fx(up) / close - 1) * 100
        float dL = (fx(lw) / close - 1) * 100
        bool yakinU = up - pC <= yakAtr * atr14
        bool yakinL = pC - lw <= yakAtr * atr14
        satir(r, "Üçgen", ucgAd() + " (" + str.tostring(fDok) + " dokunuş)", color.lime)
        satir(r + 1, "Üst çizgi (direnç)", str.tostring(fx(up), format.mintick) + "  (" + (dU >= 0 ? "+" : "") + str.tostring(dU, "#.##") + "%)" + (yakinU ? "  ⚠ YAKIN" : ""), yakinU ? color.orange : color.white)
        satir(r + 2, "Alt çizgi (destek)", str.tostring(fx(lw), format.mintick) + "  (" + (dL >= 0 ? "+" : "") + str.tostring(dL, "#.##") + "%)" + (yakinL ? "  ⚠ YAKIN" : ""), yakinL ? color.aqua : color.white)
        satir(r + 3, "Yukarı / aşağı hedef", str.tostring(fx(up + fw0), format.mintick) + " / " + str.tostring(fx(lw - fw0), format.mintick), color.gray)
        satir(r + 4, "Yukarı kırılırsa", guvenKisa(ucgDe(true)), dereceRenk(derece(stHucre(ucgDe(true), tfIdx))))
        satir(r + 5, "Aşağı kırılırsa", guvenKisa(ucgDe(false)), dereceRenk(derece(stHucre(ucgDe(false), tfIdx))))
        satir(r + 6, "En iyi zaman dilimi", "▲ " + enIyiYazi(ucgDe(true), true) + " · ▼ " + enIyiYazi(ucgDe(false), true), color.silver)
        string et = etAktif
        satir(r + 7, "▲ Hedef yolunda eski tepe", et, str.startswith(et, "var") ? color.lime : color.gray)
        int dsU = degSay(fx0, false)
        satir(r + 8, "▲ Üst çizgiye değen mum", str.tostring(dsU) + (dsU >= 11 ? "  ⚠ fazla" : "  ✓"), dsU >= 11 ? color.orange : color.lime)
        r += 9
        if hfYon != 0
            satir(r, "Haftalık trend", hfYon > 0 ? "▲ yönünde (yukarı kırılım için ✓)" : "▼ yönünde", hfYon > 0 ? color.lime : color.gray)
            r += 1
    if dVar
        float nlS = dBoyun(b)
        float hd = dTers ? nlS + dYuk : nlS - dYuk
        bool yakinB = math.abs(pC - nlS) <= yakAtr * atr14
        satir(r, "Dönüş", desenAd(dTur) + " (onay bekliyor)", dTers ? color.lime : color.red)
        satir(r + 1, "Boyun çizgisi", str.tostring(fx(nlS), format.mintick) + "  (" + (fx(nlS) >= close ? "+" : "") + str.tostring((fx(nlS) / close - 1) * 100, "#.##") + "%)" + (yakinB ? "  ⚠ YAKIN" : ""), yakinB ? color.yellow : color.white)
        satir(r + 2, "Hedef / geçersizlik", str.tostring(fx(hd), format.mintick) + " / " + str.tostring(fx(dGec), format.mintick) + " · " + rrMetin(rrFiyat(nlS, dGec, hd, dTers)), color.gray)
        satir(r + 3, "Onaylanırsa", guvenKisa(desenNo(dTur)), dereceRenk(derece(stHucre(desenNo(dTur), tfIdx))))
        satir(r + 4, "En iyi zaman dilimi", enIyiYazi(desenNo(dTur), true), color.silver)
        r += 5
    if not aktif and not dVar
        satir(1, "Durum", "Aktif formasyon yok", color.gray)
        r := 2
    if not na(ksBar) and b - ksBar <= 60
        satir(r, "Son kırılım planı", "½ sat " + str.tostring(ksY1, format.mintick) + " · kalan " + str.tostring(ksY2, format.mintick), color.yellow)
        r += 1
    satir(r, "Bu sembol", semYazi(), color.silver)
