var int    fDok = 0
var string fKey = ""
var bool   fBuyuk = false     // aktif üçgen büyük üçgen mi
var bool   yakU = false
var bool   yakL = false

// dönüş formasyonu: aday (a…) ve aktif (d…). Noktalar: ikili 3, OBO 5 (tepe/dip sırayla).
var bool   aVar = false
var string aTur = ""
var bool   aTers = false
var float  aYuk = na
